# ============================================================
# PS-25 Modular SSOT v1.0 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# --- Database (PostgreSQL via Supabase / Supavisor) ---
# Development: local PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ps25
# Production: Supabase connection string
# DATABASE_URL=postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ps25

# --- JWT (python-jose, HS256) ---
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Development: Vite dev server
FRONTEND_URL=http://localhost:5173
# Production: Vercel deployment URL
# FRONTEND_URL=https://ps25-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Mock OTP (Development Only) ---
MOCK_OTP=123456

# --- LLM Provider (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=meta-llama/llama-70b-chat:latest

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000