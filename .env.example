# ============================================================
# PS-25 Modular SSOT v2.0 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# --- Database (PostgreSQL via psycopg3) ---
# Development: local PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ps25
# Production: Supabase connection string
# DATABASE_URL=postgresql+psycopg://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- JWT (python-jose, HS256) ---
JWT_SECRET=change-me-in-development-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Development: Vite dev server
FRONTEND_URL=http://localhost:5173
# Production: Vercel deployment URL
# FRONTEND_URL=https://ps25-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Mock OTP (Development Only) ---
MOCK_OTP=123456

# --- LLM Provider (OpenRouter) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL_PRIMARY=meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL_FALLBACK=mistralai/mixtral-8x7b-instruct

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000